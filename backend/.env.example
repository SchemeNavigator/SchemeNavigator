# Environment variables for SchemeNavigator backend
# Copy this file to .env and fill in real values

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://schemenav:schemenav@localhost:5432/schemenav

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LiteLLM / AI Agents ──────────────────────────────────────────────────────
# Set to the API key for whichever provider you use with LiteLLM.
# Examples:
#   LITELLM_MODEL=gpt-4o-mini           (OpenAI)
#   LITELLM_MODEL=gemini/gemini-1.5-flash  (Google)
#   LITELLM_MODEL=anthropic/claude-3-haiku  (Anthropic)
#   LITELLM_MODEL=ollama/llama3          (local Ollama)
LITELLM_API_KEY=sk-your-api-key-here
LITELLM_MODEL=gpt-4o-mini
LITELLM_TEMPERATURE=0.3
LITELLM_MAX_TOKENS=1024

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TOKEN_EXPIRY_DAYS=90
